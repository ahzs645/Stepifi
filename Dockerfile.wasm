# Build WASM module - outputs only stltostp.js and stltostp.wasm
FROM emscripten/emsdk:3.1.51 AS builder

WORKDIR /build

# Copy WASM source files
COPY wasm/ ./wasm/

# Build WASM module
RUN emcc \
    -std=c++11 \
    -O3 \
    -s WASM=1 \
    -s MODULARIZE=1 \
    -s EXPORT_NAME="createStlToStpModule" \
    -s ENVIRONMENT='web' \
    -s ALLOW_MEMORY_GROWTH=1 \
    -s MAXIMUM_MEMORY=1GB \
    -s EXPORTED_RUNTIME_METHODS='["ccall","cwrap"]' \
    --bind \
    -I./wasm \
    ./wasm/stltostp_wasm.cpp \
    -o ./stltostp.js

# Final stage - only the files we need
FROM scratch
COPY --from=builder /build/stltostp.js /
COPY --from=builder /build/stltostp.wasm /
